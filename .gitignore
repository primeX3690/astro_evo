# Python bytecode cache (Faltu automatic files)
__pycache__/
*.pyc
*.pyo
*.pyd

# Operating System files
.DS_Store
Thumbs.db

# Virtual environment (Future ke liye safety)
.venv/
venv/
ENV/

# Local configuration
config/virtual_hardware.json
# Compiled native kernels (built on the user's own machine, never shipped)
core_engine/native/*.so
core_engine/native/*.dll
core_engine/native/*.dylib
core_engine/native/*.failed
